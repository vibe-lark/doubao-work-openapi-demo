{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@api/auth": [
        "src/api-shim/auth.ts"
      ],
      "@api/doubao": [
        "src/api-shim/doubao.ts"
      ],
      "@api/boundary": [
        "src/api-shim/boundary.ts"
      ],
      "@shared/schema": [
        "shared/schema.ts"
      ],
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src",
    "shared"
  ]
}
