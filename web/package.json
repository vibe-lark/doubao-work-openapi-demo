{
  "name": "doubao-work-openapi-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "豆包工作 Open API 能力展示台 · 独立 Node 版前端（构建产物 dist/ 已提交，可免构建使用）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test ../test/sidepanel.test.mjs ../test/sso.test.mjs",
    "check:secrets": "node ../scripts/check-secrets.mjs",
    "prebuild": "npm run check:secrets"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
