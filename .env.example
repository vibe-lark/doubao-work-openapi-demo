# 独立 Node 版配置（server 只读 process.env；可 `set -a; source .env; set +a` 后启动）
# 飞书自建应用 App ID / Secret（仅服务端持有，绝不入库、绝不下发浏览器）
OAUTH_CLIENT_ID=your_feishu_client_id
OAUTH_CLIENT_SECRET=your_feishu_client_secret

# 必须与开放平台后台登记的重定向 URI 完全一致
REDIRECT_URI=http://127.0.0.1:4110/api/auth/feishu/callback

# 设为 1 时授权附带 offline_access scope 以获取 refresh_token（需应用后台已开通「刷新 user_access_token」）；
# 未开启时 token 到期（约 2 小时）后页面会回到授权页，需要重新授权。
OAUTH_OFFLINE_ACCESS=0

# 本地监听
PORT=4110
# 仅本机访问；需要局域网访问设 0.0.0.0（注意令牌落盘安全）
HOST=127.0.0.1

# ppe（默认）| online；破坏性/边界用例只在 PPE 跑
ENV=ppe
